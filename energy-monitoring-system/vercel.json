{
  "version": 2,
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/proxy.js?path=$1"
    },
    {
      "src": "/health",
      "dest": "/api/proxy.js?path=health"
    },
    {
      "src": "/status",
      "dest": "/api/proxy.js?path=status"
    },
    {
      "src": "/(.*\\.css)",
      "dest": "frontend/$1"
    },
    {
      "src": "/(.*\\.js)",
      "dest": "frontend/$1"
    },
    {
      "src": "/(.*\\.png|.*\\.jpg|.*\\.jpeg|.*\\.gif|.*\\.ico|.*\\.svg)",
      "dest": "frontend/$1"
    },
    {
      "src": "/login\\.html",
      "dest": "frontend/login.html"
    },
    {
      "src": "/index\\.html",
      "dest": "frontend/index.html"
    },
    {
      "src": "/login\\.css",
      "dest": "frontend/login.css"
    },
    {
      "src": "/login\\.js",
      "dest": "frontend/login.js"
    },
    {
      "src": "/app\\.js",
      "dest": "frontend/app.js"
    },
    {
      "src": "/style\\.css",
      "dest": "frontend/style.css"
    },
    {
      "src": "/",
      "dest": "frontend/login.html"
    }
  ]
}
