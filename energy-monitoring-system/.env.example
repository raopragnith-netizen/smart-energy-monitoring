# Server
PORT=3000

# MongoDB (use MongoDB Atlas URI for production)
MONGODB_URI=mongodb://127.0.0.1:27017/energy_monitoring
# For production: MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/energy_monitoring

# ML Service
ML_SERVICE_URL=http://localhost:5000

# JWT Secret (CHANGE THIS in production!)
JWT_SECRET=change_this_to_a_random_256_bit_key

# Email Configuration (optional — for alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
FROM_EMAIL=your_email@gmail.com

# Vercel will auto-set VERCEL=1 in serverless mode
# Do NOT set this manually for local development
